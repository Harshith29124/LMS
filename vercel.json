{
  "version": 2,
  "framework": "vite",
  "name": "craftconnect-lms",
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": "/api/auth.js"
    },
    {
      "source": "/api/courses/(.*)",
      "destination": "/api/courses.js"
    },
    {
      "source": "/api/lessons/(.*)",
      "destination": "/api/lessons.js"
    },
    {
      "source": "/api/quiz/(.*)",
      "destination": "/api/quiz.js"
    },
    {
      "source": "/api/enroll/(.*)",
      "destination": "/api/enrollment.js"
    },
    {
      "source": "/api/progress/(.*)",
      "destination": "/api/enrollment.js"
    },
    {
      "source": "/api/courses",
      "destination": "/api/courses.js"
    },
    {
      "source": "/api/courses/",
      "destination": "/api/courses.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
